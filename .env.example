
# Application
APP_ENV=development

# Database
DATABASE_URL=postgresql+psycopg://healthguard:CHANGE_ME@postgres:5432/healthguard
LANGGRAPH_CHECKPOINTER_URL=postgresql://healthguard:CHANGE_ME@postgres:5432/healthguard

# Redis
REDIS_URL=redis://:CHANGE_ME@redis:6379/0
CACHE_KEY_SECRET=CHANGE_ME

# Authentication
JWT_SECRET_KEY=CHANGE_ME
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# AWS
AWS_REGION=eu-north-1
AWS_S3_BUCKET=REPLACE_WITH_YOUR_BUCKET
S3_SERVER_SIDE_ENCRYPTION=AES256

# AI providers
GROQ_API_KEY=
GOOGLE_API_KEY=
GROQ_MODEL=REPLACE_WITH_MODEL
GROQ_FAST_MODEL=REPLACE_WITH_MODEL
GEMINI_EVAL_MODEL=REPLACE_WITH_MODEL

# AI reliability
AI_MODEL_TIMEOUT=30
AI_MODEL_MAX_RETRIES=2

# File upload
MAX_FILE_SIZE_MB=10

# LangSmith
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=HealthGuard-AI
